# Contact: thezone@news.thezone.lv
# Server
PORT=10080
JWT_SECRET=CHANGE_ME

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars
# 1 = public URLs (neexpirē), 0 = signed URLs (1h). Public vajag Storage policy SELECT anon.
SUPABASE_STORAGE_PUBLIC=0
SUPABASE_AVATAR_SIGNED_TTL=3600
SUPABASE_AVATAR_CACHE_CONTROL=3600

# Chat history (Supabase)
CHAT_STORE_MODE=supabase
CHAT_STORE_TABLE=chat_messages
CHAT_HISTORY_LIMIT=60
CHAT_RETENTION_DAYS=14
CHAT_CLEANUP_INTERVAL_MS=21600000

# Users / Reports storage (Supabase)
USERS_STORE_MODE=supabase
USERS_STORE_TABLE=vz_users
USERS_STORE_BATCH=500

REPORTS_STORE_MODE=supabase
REPORTS_STORE_TABLE=vz_reports
REPORTS_STORE_BATCH=500

# DM storage
DM_STORE_MODE=client

# Referrāla bonusi (coins)
REFERRAL_COINS_REFERRER=50
REFERRAL_COINS_REFEREE=25

# Avatar payload limits
AVATAR_INLINE_MAX_CHARS=120000
DM_META_AVATAR_MAX_CHARS=0

# Paroles atjaunošana (e-pasti caur Resend)
# Bez RESEND_API_KEY lietotāji redzēs 503 un instrukciju rakstīt uz thezone@news.thezone.lv
RESEND_API_KEY=
RESEND_FROM=Vārdu Zona <noreply@thezone.lv>
BASE_URL=https://bugats-wordle-server.onrender.com
